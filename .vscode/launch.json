{
    "version": "0.2.0",
    "configurations": [
        {
            "type": "stlinkgdbtarget",
            "request": "launch",
            "name": "STM32N6570-DK (UVC)",
            "cwd": "${workspaceFolder}",
            "preLaunchTask": "CMake Build (Debug UVC)",
            "device": "STM32N657X0HxQ",
            "deviceCore": "Cortex-M55",
            "runEntry": "main",
            "svdPath": "${workspaceFolder}/tools/STM32CubeCLT/STMicroelectronics_CMSIS_SVD/STM32N657.svd",

            "imagesAndSymbols": [
                {
                    "symbolFileName": "${workspaceFolder}/build/Debug/Project.elf",
                    "imageFileName": "${workspaceFolder}/build/Debug/Project.elf"
                }
            ],
            "serverExtLoader": [
                {
                    "loader": "${workspaceFolder}/tools/STM32CubeCLT/STM32CubeProgrammer/bin/ExternalLoader/MX66UW1G45G_STM32N6570-DK.stldr",
                    "initialize": false
                }
            ]
        },
        {
            "type": "stlinkgdbtarget",
            "request": "launch",
            "name": "STM32N6570-DK (LCD)",
            "cwd": "${workspaceFolder}",
            "preLaunchTask": "CMake Build (Debug LCD)",
            "device": "STM32N657X0HxQ",
            "deviceCore": "Cortex-M55",
            "runEntry": "main",
            "svdPath": "${workspaceFolder}/tools/STM32CubeCLT/STMicroelectronics_CMSIS_SVD/STM32N657.svd",
            "imagesAndSymbols": [
                {
                    "symbolFileName": "${workspaceFolder}/build/Debug-LCD/Project.elf",
                    "imageFileName": "${workspaceFolder}/build/Debug-LCD/Project.elf"
                }
            ],
            "serverExtLoader": [
                {
                    "loader": "${workspaceFolder}/tools/STM32CubeCLT/STM32CubeProgrammer/bin/ExternalLoader/MX66UW1G45G_STM32N6570-DK.stldr",
                    "initialize": false
                }
            ]
        }
    ]
}
